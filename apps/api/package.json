{
  "name": "api",
  "version": "1.0.0",
  "description": "main backend api server",
  "type": "commonjs",
  "main": "main.py",
  "scripts": {
    "start": "uv run fastapi run src/main.py --port 8000",
    "dev": "uv run fastapi dev",

    "db:generate": "uv run alembic revision --autogenerate -m",
    "db:migrate": "uv run alembic upgrade head"
  }
}